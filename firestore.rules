rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // RSVPs collection rules
    match /rsvps/{rsvpId} {
      // 1. Anyone (including unauthenticated guests with their unique link) can read single RSVP by ID
      allow get: if true;

      // 2. Anyone can submit a new RSVP
      allow create: if true;

      // 3. Guests can update their own RSVP confirmation details directly
      allow update: if true;

      // 4. Listing all RSVPs and deleting entries is reserved for authenticated admin users
      // (or anyone if you need public list, but listing is strictly for admins)
      allow list: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Default fallback for any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
